# Port the server listens on (ESP sends to this port)
PORT=5000

# Local MongoDB (install MongoDB Community Server) or a MongoDB Atlas connection string
MONGO_URI=mongodb://127.0.0.1:27017/community_outreach

# Any long random text; used to sign login tokens
JWT_SECRET=change_this_to_a_long_random_secret

# Cloudinary (from cloudinary.com -> Dashboard). If left empty, images are saved locally in server/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
